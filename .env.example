# 复制为 .env 后填写真实值：cp .env.example .env
# 本地 Qdrant / Neo4j：见 deploy/docker-compose.yml

# ---------- LLM（OpenAI 兼容）----------
LLM_API_KEY=
LLM_MODEL_ID=
LLM_BASE_URL=

# ---------- 搜索（可选）----------
SERPAPI_API_KEY=

# ---------- Qdrant（本地 Docker：无 API Key，留空）----------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=hello_agents_vectors
# 必须与当前使用的 Embedding 模型输出维度一致
QDRANT_VECTOR_SIZE=512
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT=30

# ---------- Neo4j（本地 Docker，与 compose 中 NEO4J_AUTH 一致）----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=hello-agents-password
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=60

# ---------- Embedding ----------
# dashscope / local 等，见 hello_agents 文档
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=text-embedding-v4
EMBED_API_KEY=
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
